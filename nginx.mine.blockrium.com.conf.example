server {
    listen 80;
    server_name mine.blockrium.com;
    root /var/www/mine.blockrium.com/current;
    index index.html;

    location /api/ {
        proxy_pass https://maticlegend.com/api/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name maticlegend.com;
        proxy_set_header Host maticlegend.com;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-Host mine.blockrium.com;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 8m;
        proxy_connect_timeout 15s;
        proxy_read_timeout 30s;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
    }
}
