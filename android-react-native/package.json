{
  "name": "Blockrium",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:clean": "cd android && gradlew clean",
    "android:build": "cd android && gradlew assembleRelease",
    "android:bundle": "cd android && gradlew bundleRelease",
    "ios": "react-native run-ios",
    "ios:pods": "cd ios && bundle install && bundle exec pod install",
    "ios:build:sim": "cd ios && xcodebuild -workspace Blockrium.xcworkspace -scheme Blockrium -configuration Debug -sdk iphonesimulator -destination 'platform=iOS Simulator,name=iPhone 16' build",
    "ios:archive": "cd ios && xcodebuild -workspace Blockrium.xcworkspace -scheme Blockrium -configuration Release -archivePath build/Blockrium.xcarchive archive",
    "ios:export": "cd ios && xcodebuild -exportArchive -archivePath build/Blockrium.xcarchive -exportPath build/export -exportOptionsPlist ExportOptions.example.plist",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "start": "react-native start",
    "test": "jest",
    "test:metro-assets": "node scripts/test-metro-assets.js",
    "typecheck:app": "tsc --noEmit --pretty false -p tsconfig.source.json"
  },
  "dependencies": {
    "@ethersproject/shims": "^5.8.0",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^21.6.1",
    "@react-native-firebase/messaging": "^21.11.0",
    "@react-native-firebase/remote-config": "^21.6.1",
    "@react-native/gradle-plugin": "^0.77",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/elements": "^1.3.31",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@shopify/flash-list": "^1.7.1",
    "async-mutex": "^0.4.0",
    "crypto-js": "^4.2.0",
    "ethers": "^6.16.0",
    "ironsource-mediation": "^3.2.0",
    "ky": "^1.7.2",
    "lottie-react-native": "^7.1.0",
    "native-base": "^2.15.2",
    "patch-package": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.77.0",
    "react-native-actions-sheet": "^0.9.7",
    "react-native-appodeal": "^4.1.0",
    "react-native-curved-bottom-bar": "^3.3.1",
    "react-native-device-info": "^14.0.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^2.20.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-image-picker": "^8.3.0",
    "react-native-inappbrowser-reborn": "^3.7.0",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-network-logger": "^1.17.0",
    "react-native-onesignal": "^5.2.14",
    "react-native-permissions": "^5.4.2",
    "react-native-purchases": "^10.1.2",
    "react-native-purchases-ui": "^10.1.2",
    "react-native-push-notification": "^8.1.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "^3.16.1",
    "react-native-responsive-fontsize": "^0.5.1",
    "react-native-responsive-screen": "^1.4.2",
    "react-native-restart": "^0.0.27",
    "react-native-safe-area-context": "^3.3.2",
    "react-native-screens": "^4.6.0",
    "react-native-share": "^11.0.4",
    "react-native-svg": "^15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-vector-icons": "^10.2.0",
    "react-native-webview": "^13.12.3",
    "react-query": "^3.39.3",
    "use-sync-external-store": "^1.2.2",
    "zustand": "^5.0.0-rc.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.77.0",
    "@react-native/eslint-config": "0.77.0",
    "@react-native/metro-config": "0.77.0",
    "@react-native/typescript-config": "0.77.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.2.6",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "native-base": {
      "react-native-vector-icons": "^10.3.0"
    },
    "ethers": {
      "ws": "^8.21.0"
    },
    "metro": {
      "image-size": "2.0.4"
    }
  }
}
